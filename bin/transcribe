#!/usr/bin/env python3
"""transcribe — единая команда транскрибации с диаризацией для AI-агентов.

Локальный, оффлайн, на Apple Neural Engine. Движок: FluidAudio Parakeet TDT v3
(ASR) + pyannote-диаризация. Источники: локальные медиафайлы и YouTube.

Выход (стандартный, для чтения ИИ-агентами):
  <out>/transcript.md     канонический для чтения (реплики по спикерам)
  <out>/transcript.json   машинный (turns + words для нарезки по таймкоду)
  <out>/manifest.json     метаданные прогона (движок, времена, RTF, команды)
  <out>/progress.json     live-трейсинг (обновляется каждые ~2 c; финал: done|error)

Трейсинг по запросу (для агента):
  transcribe status               последний активный прогон в <out-root>
  transcribe status --out DIR     прогон в конкретной папке
  transcribe status --json        машинный вывод вместо одной строки

Использование:
  transcribe <файл|youtube-url>... [--speakers auto|off|N] [--lang ru|en|auto]
             [--out DIR] [--out-root DIR] [--diar-mode streaming|offline] [--asr-model v3|v2]
"""
import argparse
import json
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))
from run import (DEFAULT_OUT_ROOT, RunError, format_duration, is_processed, run,
                 load_watch_state, normalize_formats, processing_options_hash,
                 save_watch_state, source_signature, status, status_dict,
                 status_line, watch_candidate)  # noqa: E402

WATCH_INTERVAL_S = 10.0


def _parse_formats(value: str) -> tuple[str, ...]:
    try:
        return normalize_formats(value)
    except RunError as exc:
        raise argparse.ArgumentTypeError(str(exc)) from exc


def cmd_status(argv) -> int:
    p = argparse.ArgumentParser(prog="transcribe status", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--out", default=None, help="папка прогона")
    p.add_argument("--out-root", default=None,
                   help=f"корень поиска последнего активного прогона (default {DEFAULT_OUT_ROOT})")
    p.add_argument("--json", action="store_true", help="машинный вывод")
    p.add_argument("--max-age", type=float, default=60.0,
                   help="считать прогон активным, пока progress.json не старше N сек (default 60)")
    args = p.parse_args(argv)

    st = status(Path(args.out) if args.out else None,
                out_root=Path(args.out_root) if args.out_root else DEFAULT_OUT_ROOT,
                max_age_s=args.max_age)
    if args.json:
        print(status_dict(st))
    else:
        print(status_line(st))
    return 0


def _print_result(result) -> None:
    print(f"✓ {result.speakers} спикер(ов) · {format_duration(result.duration_s)}"
          f" · ASR {result.asr_rtf}x · {result.language}")
    print(f"  {result.transcript_md}")
    print(f"  {result.transcript_json}")
    print(f"  {result.manifest}")
    for subtitle_path in result.subtitle_paths:
        print(f"  {subtitle_path}")
    if result.workdir is not None:
        print(f"  отладочные файлы сохранены: {result.workdir}")


def _watch(watch_dir: Path, *, out_root: Path, speakers: str, lang: str,
           diar_mode: str, asr_model: str, keep_tmp: bool,
           clean_fillers: bool, formats: tuple[str, ...],
           replacements_file: Path | None, retry_failed: bool) -> None:
    stable = {}
    watch_state_path = out_root / ".transcribe-watch.json"
    watch_state = load_watch_state(watch_state_path)
    sources = watch_state["sources"]
    retried_failures = set()
    processing_options_hash(
        speakers=speakers, lang=lang, diar_mode=diar_mode, asr_model=asr_model,
        clean_fillers=clean_fillers, formats=formats,
        replacements_file=replacements_file)
    while True:
        for source in sorted(watch_dir.iterdir()):
            if not watch_candidate(source, stable):
                continue
            key = source.resolve()
            signature = source_signature(source)
            if signature is None:
                continue
            options_hash = processing_options_hash(
                speakers=speakers, lang=lang, diar_mode=diar_mode,
                asr_model=asr_model, clean_fillers=clean_fillers, formats=formats,
                replacements_file=replacements_file)
            key_text = str(key)
            record = sources.get(key_text)
            same_attempt = (record is not None
                            and record.get("signature") == list(signature)
                            and record.get("options_hash") == options_hash)
            if ((record is None or same_attempt)
                    and is_processed(source, out_root, options_hash=options_hash,
                                     signature=signature)):
                if not same_attempt or record.get("status") != "done":
                    sources[key_text] = {"signature": list(signature),
                                         "options_hash": options_hash, "status": "done",
                                         "attempts": record.get("attempts", 0) if same_attempt else 0}
                    save_watch_state(watch_state_path, watch_state)
                continue
            if (same_attempt and record.get("status") == "failed"
                    and (not retry_failed or key_text in retried_failures)):
                continue
            if same_attempt and record.get("status") == "failed":
                retried_failures.add(key_text)
            attempts = (record.get("attempts", 0) + 1) if same_attempt else 1
            try:
                result = run(source, out_root=out_root, speakers=speakers, lang=lang,
                             diar_mode=diar_mode, asr_model=asr_model,
                             keep_tmp=keep_tmp, clean_fillers=clean_fillers,
                             formats=formats, replacements_file=replacements_file)
            except RunError as exc:
                print(f"transcribe: error: {source}: {exc}", file=sys.stderr)
                sources[key_text] = {"signature": list(signature),
                                     "options_hash": options_hash, "status": "failed",
                                     "attempts": attempts, "error": str(exc)}
                save_watch_state(watch_state_path, watch_state)
                continue
            sources[key_text] = {"signature": list(signature),
                                 "options_hash": (result.options_hash or options_hash),
                                 "status": "done",
                                 "attempts": attempts, "out_dir": str(result.out_dir)}
            save_watch_state(watch_state_path, watch_state)
            _print_result(result)
        time.sleep(WATCH_INTERVAL_S)


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "status":
        sys.exit(cmd_status(sys.argv[2:]))

    p = argparse.ArgumentParser(prog="transcribe", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("inputs", nargs="*", help="локальные медиафайлы или YouTube-URL")
    p.add_argument("--watch", metavar="DIR", help="следить за папкой с новыми медиафайлами")
    p.add_argument("--speakers", default="auto",
                   help="auto (детект) | off (без диаризации) | N (число спикеров)")
    p.add_argument("--lang", default="auto", help="ru | en | auto (по умолчанию auto)")
    p.add_argument("--out", default=None, help="конкретная папка вывода")
    p.add_argument("--out-root", default=None,
                   help=f"корневая папка для default output (default {DEFAULT_OUT_ROOT})")
    p.add_argument("--diar-mode", default="streaming", choices=["streaming", "offline"],
                   help="streaming (быстро, ~61x) | offline (точнее DER, медленно)")
    p.add_argument("--asr-model", default="v3", choices=["v3", "v2"])
    p.add_argument("--keep-tmp", action="store_true")
    p.add_argument("--clean-fillers", action="store_true",
                   help="удалять консервативный список слов-паразитов из реплик")
    p.add_argument("--formats", type=_parse_formats, default=(), metavar="LIST",
                   help="additional subtitle artifacts: srt,vtt")
    p.add_argument("--replacements", type=Path, default=None, metavar="JSON",
                   help="JSON dictionary of exact replacements in turn text")
    p.add_argument("--retry-failed", action="store_true",
                   help="retry persisted failed watch sources once after startup")
    args = p.parse_args()

    if args.watch:
        if args.inputs:
            p.error("--watch нельзя использовать вместе с источниками")
        if args.out:
            p.error("--out нельзя использовать с --watch; укажите --out-root")
        watch_dir = Path(args.watch)
        if not watch_dir.is_dir():
            p.error(f"папка watch не найдена: {watch_dir}")
        out_root = Path(args.out_root) if args.out_root else DEFAULT_OUT_ROOT
        try:
            _watch(watch_dir, out_root=out_root, speakers=args.speakers, lang=args.lang,
                   diar_mode=args.diar_mode, asr_model=args.asr_model,
                   keep_tmp=args.keep_tmp, clean_fillers=args.clean_fillers,
                   formats=args.formats, replacements_file=args.replacements,
                   retry_failed=args.retry_failed)
        except KeyboardInterrupt:
            return
        except RunError as exc:
            print(f"transcribe: error: {exc}", file=sys.stderr)
            sys.exit(1)

    if not args.inputs:
        p.error("укажите хотя бы один источник")
    if len(args.inputs) > 1 and args.out:
        p.error("--out нельзя использовать с несколькими источниками; укажите --out-root")

    failed = False
    for source in args.inputs:
        try:
            r = run(source,
                    out=Path(args.out) if args.out else None,
                    out_root=Path(args.out_root) if args.out_root else DEFAULT_OUT_ROOT,
                    speakers=args.speakers, lang=args.lang,
                    diar_mode=args.diar_mode, asr_model=args.asr_model,
                    keep_tmp=args.keep_tmp, clean_fillers=args.clean_fillers,
                    formats=args.formats, replacements_file=args.replacements)
        except RunError as exc:
            print(f"transcribe: error: {source}: {exc}", file=sys.stderr)
            failed = True
            continue

        _print_result(r)

    if failed:
        sys.exit(1)


if __name__ == "__main__":
    main()
